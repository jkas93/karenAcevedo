rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email is string;
    }

    function profilePath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.token.email);
    }

    function hasProfile() {
      return isAuthenticated() && exists(profilePath());
    }

    function role() {
      return get(profilePath()).data.rol;
    }

    function isSuperuser() {
      return isAuthenticated()
        && request.auth.token.email == '71260540@fuerzaciudadana.pe';
    }

    function permissionPath() {
      return /databases/$(database)/documents/rolePermissions/$(role());
    }

    function fallbackPermission(permission) {
      return role() == 'administrador' && permission in [
          'calendar.view', 'calendar.manage', 'volunteers.view', 'volunteers.manage',
          'electoral.view', 'electoral.manage',
          'actas.view', 'actas.manage', 'teamProfiles.view', 'teamProfiles.manage',
          'settings.view', 'settings.manage', 'users.view', 'users.manage'
        ]
        || role() == 'candidata' && permission in [
          'calendar.view', 'calendar.manage', 'volunteers.view', 'volunteers.manage',
          'electoral.view'
        ]
        || role() == 'digitador' && permission in [
          'calendar.view', 'actas.view', 'actas.manage'
        ]
        || role() == 'coordinador' && permission in [
          'electoral.view', 'electoral.manage'
        ]
        || role() == 'usuario' && permission in [
          'calendar.view', 'volunteers.view', 'volunteers.manage'
        ];
    }

    function hasPermission(permission) {
      return isSuperuser()
        || (hasProfile()
          && (exists(permissionPath())
            ? get(permissionPath()).data.permissions[permission] == true
            : fallbackPermission(permission)));
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.token.email == userId;
    }

    function validCalendarActivity() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'titulo', 'descripcion', 'inicio', 'fin', 'todoElDia', 'ubicacion',
          'responsableId', 'responsableNombre', 'categoria', 'prioridad', 'estado',
          'creadoPor', 'creadoPorNombre', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'titulo', 'descripcion', 'inicio', 'fin', 'todoElDia', 'ubicacion',
          'responsableId', 'responsableNombre', 'categoria', 'prioridad', 'estado',
          'timeZone', 'creadoPor', 'creadoPorNombre', 'createdAt', 'updatedAt'
        ])
        && data.titulo is string
        && data.titulo.size() >= 2
        && data.titulo.size() <= 120
        && data.descripcion is string
        && data.descripcion.size() <= 2000
        && data.inicio is timestamp
        && data.fin is timestamp
        && data.fin > data.inicio
        && data.todoElDia is bool
        && data.ubicacion is string
        && data.ubicacion.size() <= 200
        && data.responsableId is string
        && data.responsableId.size() <= 254
        && data.responsableNombre is string
        && data.responsableNombre.size() >= 1
        && data.responsableNombre.size() <= 120
        && data.categoria in ['territorio', 'reunion', 'comunicacion', 'capacitacion', 'electoral', 'logistica']
        && data.prioridad in ['baja', 'normal', 'alta']
        && data.estado in ['programada', 'confirmada', 'completada', 'cancelada']
        && (!('timeZone' in data) || data.timeZone == 'America/Lima')
        && data.creadoPor is string
        && data.creadoPorNombre is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/usuarios/$(data.responsableId));
    }
    match /voluntarios/{docId} {
      allow create: if false;
      allow read: if hasPermission('volunteers.view');
      allow update: if hasPermission('volunteers.manage')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado in ['pendiente', 'contactado', 'rechazado'];
      allow delete: if hasPermission('volunteers.manage');
    }

    match /usuarios/{userId} {
      allow get: if isSelf(userId) || hasPermission('users.view')
        || hasPermission('calendar.manage') || hasPermission('electoral.manage');
      allow list: if hasPermission('users.view')
        || hasPermission('calendar.manage') || hasPermission('electoral.manage');
      allow create, update, delete: if false;
    }

    match /locales/{docId} {
      allow read: if hasPermission('electoral.view') || hasPermission('actas.view')
        || hasPermission('settings.view');
      allow update: if hasPermission('electoral.manage');
      allow create, delete: if false;
    }

    match /mesas/{docId} {
      allow read: if hasPermission('electoral.view') || hasPermission('actas.view')
        || hasPermission('settings.view');
      // Cada mesa nace junto con el acta validada mediante la API administrativa.
      allow create, update, delete: if false;
    }

    match /actas/{docId} {
      allow read: if hasPermission('electoral.view') || hasPermission('actas.view');
      // Conversión WebP, OCR, validación y persistencia son atómicas y server-only.
      allow create, update, delete: if false;
    }

    match /actaDrafts/{docId} {
      allow read, write: if false;
    }

    match /electoralCounters/{docId} {
      allow read, write: if false;
    }

    match /personeros/{docId} {
      allow read: if hasPermission('electoral.view');
      // Las escrituras pasan por la API administrativa para validar DNI, celular,
      // local, mesa y permisos de forma atómica.
      allow create, update, delete: if false;
    }

    match /config/{docId} {
      allow read: if hasPermission('settings.view');
      allow create, update: if hasPermission('settings.manage')
        && request.resource.data.keys().hasAll(['whatsapp', 'correo'])
        && request.resource.data.keys().hasOnly(['whatsapp', 'correo'])
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 9
        && request.resource.data.whatsapp.size() <= 15
        && request.resource.data.correo is string
        && request.resource.data.correo.size() <= 254;
      allow delete: if false;
    }

    match /calendario_actividades/{docId} {
      allow read: if hasPermission('calendar.view');
      allow create: if hasPermission('calendar.manage')
        && request.resource.data.creadoPor == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validCalendarActivity();
      allow update: if hasPermission('calendar.manage')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'titulo', 'descripcion', 'inicio', 'fin', 'todoElDia', 'ubicacion',
          'responsableId', 'responsableNombre', 'categoria', 'prioridad', 'estado', 'timeZone',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && validCalendarActivity();
      allow delete: if hasPermission('calendar.manage');
    }

    match /rolePermissions/{docId} {
      allow read, write: if false;
    }

    match /accessAudit/{docId} {
      allow read, write: if false;
    }

    match /pushSubscriptions/{docId} {
      allow read, write: if false;
    }

    match /notificationDeliveries/{docId} {
      allow read, write: if false;
    }

    match /notificationDeviceEvents/{docId} {
      allow read, write: if false;
    }

    match /notificationReminderDeliveries/{docId} {
      allow read, write: if false;
    }

    match /teamProfiles/{docId} {
      allow read, write: if false;
    }

    match /teamIntakeConfig/{docId} {
      allow read, write: if false;
    }

    match /teamIntakeRateLimits/{docId} {
      allow read, write: if false;
    }

    match /volunteerRateLimits/{docId} {
      allow read, write: if false;
    }

    match /systemLocks/{docId} {
      allow read, write: if false;
    }

    match /electoralAudit/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      // Auto Clicker collections (including nested audit) are server-only.
      // Firebase Admin operations enforce permissions in /api/autoclicker.
      allow read, write: if false;
    }
  }
}
