rules_version = '2';

service firebase.storage {
  // Requiere roles/firebaserules.firestoreServiceAgent para consultar perfiles.
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email is string;
    }

    function role() {
      return firestore.get(
        /databases/(default)/documents/usuarios/$(request.auth.token.email)
      ).data.rol;
    }

    function isSuperuser() {
      return isAuthenticated()
        && request.auth.token.email == '71260540@fuerzaciudadana.pe';
    }

    function permissionPath() {
      return /databases/(default)/documents/rolePermissions/$(role());
    }

    function fallbackPermission(permission) {
      return role() == 'administrador'
        && permission in ['electoral.view', 'electoral.manage', 'actas.view', 'actas.manage']
        || role() == 'candidata' && permission == 'electoral.view'
        || role() == 'digitador' && permission in ['actas.view', 'actas.manage'];
    }

    function hasPermission(permission) {
      return isSuperuser()
        || (isAuthenticated()
          && (firestore.exists(permissionPath())
            ? firestore.get(permissionPath()).data.permissions[permission] == true
            : fallbackPermission(permission)));
    }

    match /actas/{fileName} {
      allow read: if hasPermission('electoral.view') || hasPermission('actas.view');
      allow create: if hasPermission('actas.manage')
        && resource == null
        && fileName.matches('.*\\.webp')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'image/webp';
      allow update: if false;
      allow delete: if hasPermission('electoral.manage')
        || (hasPermission('actas.manage')
          && resource.metadata.ownerUid == request.auth.uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
